NOTION_TYPE_PROPERTY=Type
NOTION_DUE_DATE_PROPERTY=Date
NOTION_AREA_PROPERTY=Area
NOTION_COURSE_PROPERTY=Course
NOTION_COURSE_CODE_PROPERTY=Course Code
